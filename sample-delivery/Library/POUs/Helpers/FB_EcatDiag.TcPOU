<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.0.26">
  <POU Name="FB_EcatDiag" Id="{5f761df3-17d1-44c1-84cd-865068aed9a8}">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_EcatDiag
VAR_INPUT
    i_AMSNetId	:	AMSNETID; //Connect this to an AMSNETID structure as a PLC input. Then link the input to the AMSNETID name in the master info.
    i_xFirstPass	:	BOOL;
    i_xReset	:	BOOL; //Acknowledge and clear a latched read fault
    i_tTimeout	:	TIME := T#5S; //Bound on a single asynchronous slave-state read
END_VAR
VAR_OUTPUT
    q_xAllStatesGood	:	BOOL;
    q_xError	:	BOOL; //Latched: the slave-state read failed or did not complete in time
    q_xTimeout	:	BOOL; //Latched: the read did not complete within i_tTimeout
    q_sResult	:	STRING; //Explicit diagnostic message for the latched fault
END_VAR
VAR
    sNetId : T_AmsNetId;
    astTermStates : ARRAY[1..256] OF ST_EcSlaveState;

    fbGetAllSlaveStates     : FB_EcGetAllSlaveStates;
    ftReset	: F_TRIG;
    tonWatchdog	:	TON; //Bounds the asynchronous slave-state read

    iterator: INT;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[//Create the net ID string
sNetID := F_CreateAmsNetId(i_AMSNetId);

//Query the state of all terminals, collect in astTermStates
ftReset(CLK:=fbGetAllSlaveStates.bBusy OR i_xFirstPass);
fbGetAllSlaveStates.bExecute := ftReset.Q;
fbGetAllSlaveStates(sNetId:=sNetId, pStateBuf := ADR(astTermStates), cbBufLen:=SIZEOF(astTermStates));
//Keep checking...

//Acknowledge a latched read fault
IF i_xReset THEN
    q_xError := FALSE;
    q_xTimeout := FALSE;
    q_sResult := '';
END_IF

//Bound the asynchronous read: a hung fieldbus read must not go unnoticed
tonWatchdog(IN := fbGetAllSlaveStates.bBusy, PT := i_tTimeout);

//Cycle through each entry in the array and check if we have anyone not in OP and that the link state is good.
// If so, then set our global IO bad boolean.
q_xAllStatesGood := TRUE;
IF fbGetAllSlaveStates.nSlaves > 0 THEN
FOR iterator := 1 TO (fbGetAllSlaveStates.nSlaves -1) BY 1
    DO
    IF NOT( (astTermStates[iterator].deviceState = EC_DEVICE_STATE_OP) AND (astTermStates[iterator].linkState = EC_LINK_STATE_OK)) THEN
        q_xAllStatesGood := FALSE;
    END_IF
END_FOR
ELSE
    //No slave data has been read yet: report bad rather than trusting stale data
    q_xAllStatesGood := FALSE;
END_IF

//A failed or timed out read is a fault and never counts as healthy IO
IF fbGetAllSlaveStates.bError THEN
    q_xError := TRUE;
    q_xAllStatesGood := FALSE;
    q_sResult := CONCAT('EtherCAT slave state read failed with error: ', UDINT_TO_STRING(fbGetAllSlaveStates.nErrId));
ELSIF tonWatchdog.Q THEN
    q_xError := TRUE;
    q_xTimeout := TRUE;
    q_xAllStatesGood := FALSE;
    q_sResult := CONCAT('EtherCAT slave state read did not complete within ', TIME_TO_STRING(i_tTimeout));
END_IF]]></ST>
    </Implementation>
    <ObjectProperties />
  </POU>
</TcPlcObject>