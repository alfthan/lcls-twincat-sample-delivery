<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <POU Name="FB_VICI_EPS_LOGIC" Id="{79a477eb-cca3-419f-8b1e-8d6d23651e0e}" SpecialFunc="None">
    <Declaration><![CDATA[(*
FB_VICI_EPS_LOGIC
Purpose  : Decide which port of a multi port VICI valve may be selected from the per port EPS
           interlock flags and report the true lock state of the valve to the caller.
Usage    : Called once per PLC cycle with the port EPS array. aPortEPS and bOverride are shared
           with the caller so the override request can be cleared here when it expires.
Objectives:
  - A port is selectable only when all of its EPS flags are satisfied (stEPS.bEPS_OK).
  - bAllPortsLocked and bExternalLockSignal always report the real device state. A manual
    override may select a port for maintenance, but it never masks a lock or a fault.
  - The manual override is honoured only after bOverride has been requested continuously for
    tEPS_OVRD_QUAL_TIME, it clears itself after tEPS_OVRD_RESET_TIME, and it stays in series
    with the EPS interlock: while every port is locked no motion is permitted.
History  : 2026-11-27 - taio-generic-0 - interlock respecting, time qualified override.
*)
FUNCTION_BLOCK FB_VICI_EPS_LOGIC
VAR_INPUT
    iReqPort : INT;             // Port requested by the operator.
    iPrevPort : INT;            // Port the valve currently sits on.
    iNumPorts : INT;            // Number of valid ports in aPortEPS.
END_VAR
VAR_IN_OUT
    aPortEPS : ARRAY [*] OF E_VICI_PORT_EPS; // EPS for each port.
    bOverride : BOOL;                        // Manual override request. Cleared by this FB when it expires.
END_VAR
VAR_OUTPUT
    bAllPortsLocked : BOOL;     // TRUE when every port reports EPS not OK. Never masked by the override.
    bExternalLockSignal : BOOL; // Signals if previously active port becomes locked. Never masked by the override.
    bOverrideQualified : BOOL;  // TRUE once the override request has been held for tEPS_OVRD_QUAL_TIME.
    iNewPortPos : INT;
    tEPS_TimerCountDown : STRING;
END_VAR
VAR
    fbTimer : TON;                       // Override auto reset timer.
    tEPS_OVRD_RESET_TIME : TIME := T#1m; // Override duration. Must be longer than tEPS_OVRD_QUAL_TIME.
    fbOvrdQual : TON;                    // Override qualification timer.
    tEPS_OVRD_QUAL_TIME : TIME := T#10s; // Continuous override request time before it is honoured.
    fbEPS : FB_EPS;
    iIndex : INT := 1;
    iEPS_NOT_OK_COUNT : INT;
    bReqPortValid : BOOL;                // iReqPort is inside the port array.
    bPortSelectPermit : BOOL;            // The requested port may be selected this cycle.
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[M_RESET_EPS_TIMER();  // Clear the override request once its duration has elapsed.
M_QUALIFY_OVERRIDE(); // Honour the override only once its qualification time has elapsed.

// Evaluate all EPS. The port status only reflects the device state, never the override.
FOR iIndex := 1 TO iNumPorts BY 1 DO

    fbEPS(eps := aPortEPS[iIndex].stEPS);

    IF aPortEPS[iIndex].stEPS.bEPS_OK THEN
        aPortEPS[iIndex].ePortStatus := E_VICI_EPS_PORT_STATUS.UNLOCKED;
    ELSE
        aPortEPS[iIndex].ePortStatus := E_VICI_EPS_PORT_STATUS.LOCKED;
        iEPS_NOT_OK_COUNT := iEPS_NOT_OK_COUNT + 1;
    END_IF

END_FOR

// Every port locked is the EPS interlock condition. It is reported truthfully and never overridden.
IF iEPS_NOT_OK_COUNT = iNumPorts THEN
    bAllPortsLocked := TRUE;
ELSE
    bAllPortsLocked := FALSE;
END_IF

bReqPortValid := (iReqPort >= 1) AND (iReqPort <= iNumPorts);
iNewPortPos := iPrevPort;

IF bReqPortValid THEN
    // Port selection. A qualified override may substitute for a single port's EPS permission for
    // maintenance, but it stays in series with the EPS interlock: while all ports are locked the
    // override permits no motion.
    bPortSelectPermit := aPortEPS[iReqPort].stEPS.bEPS_OK OR (bOverrideQualified AND NOT bAllPortsLocked);

    IF bPortSelectPermit THEN
        iNewPortPos := iReqPort;
        // Only a genuinely unlocked port is reported active, so an override never masks a lock.
        IF aPortEPS[iReqPort].stEPS.bEPS_OK THEN
            aPortEPS[iReqPort].ePortStatus := E_VICI_EPS_PORT_STATUS.ACTIVE;
        END_IF
    END_IF
END_IF

// External lock signal: the true state of the port the valve is on, whatever the override does.
IF bReqPortValid AND (iReqPort = iPrevPort) THEN
    bExternalLockSignal := NOT aPortEPS[iReqPort].stEPS.bEPS_OK;
END_IF

iIndex := 1;
iEPS_NOT_OK_COUNT := 0;
]]></ST>
    </Implementation>
    <Method Name="M_RESET_EPS_TIMER" Id="{753f5f4a-0a99-4c0c-9d78-aa519bd706dc}">
      <Declaration><![CDATA[METHOD M_RESET_EPS_TIMER : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[fbTimer(IN := bOverride, PT:= tEPS_OVRD_RESET_TIME);

IF bOverride THEN
    tEPS_TimerCountDown := TIME_TO_STRING(tEPS_OVRD_RESET_TIME - fbTimer.ET);
END_IF

IF fbTimer.Q THEN
    bOverride := FALSE;
    tEPS_TimerCountDown := TIME_TO_STRING(T#0s);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_QUALIFY_OVERRIDE" Id="{5b1f3c47-9a2e-4c8d-9f31-6d1c0b7a2e54}">
      <Declaration><![CDATA[METHOD M_QUALIFY_OVERRIDE : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// The override is honoured only after bOverride has been requested continuously for
// tEPS_OVRD_QUAL_TIME. A blip on the request restarts the qualification.
fbOvrdQual(IN := bOverride, PT := tEPS_OVRD_QUAL_TIME);
bOverrideQualified := fbOvrdQual.Q;]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_SET_OVRD_QUAL_TIME" Id="{c4a8e2d1-7b53-4f96-a802-19e3d5c7b6f0}">
      <Declaration><![CDATA[METHOD M_SET_OVRD_QUAL_TIME : BOOL
VAR_INPUT
    tNewTime : TIME; // Continuous override request time before the override is honoured.
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[tEPS_OVRD_QUAL_TIME := tNewTime;]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_SET_OVERRIDE_RESET_TIME" Id="{0876c948-a096-48aa-a92d-6ef9e6793d6f}">
      <Declaration><![CDATA[METHOD M_SET_OVERRIDE_RESET_TIME : BOOL
VAR_INPUT
    tNewTime : TIME;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[tEPS_OVRD_RESET_TIME := tNewTime;]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>