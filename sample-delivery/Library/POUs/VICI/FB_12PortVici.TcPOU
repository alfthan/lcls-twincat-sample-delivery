<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <POU Name="FB_12PortVici" Id="{39c56d45-d70d-4786-9ea2-d6185d38aae9}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_12PortVici
(*
    Purpose : Twelve port VICI selector valve device block.
    Usage   : Call every cyclic scan. The rising edge of i_xExecute commands the
              port in iReqPos, the falling edge aborts the command and i_xAck
              clears the latched result.
    Objectives: the valve command is edge triggered and its result is latched for
              the caller to acknowledge.
    History :
        2026-11-27  Execute/acknowledge handshake added; the valve driver is no
                    longer armed with a constant TRUE execute.
*)
VAR_INPUT
    iAddress   : INT;    (* valve address on the serial bus *)
    i_xExecute : BOOL;   (* rising edge commands the port in iReqPos, falling edge aborts *)
    i_xAck     : BOOL;   (* TRUE clears the latched result *)
END_VAR
VAR_OUTPUT
    q_xDone    : BOOL;   (* latched: the last command completed *)
    q_xError   : BOOL;   (* latched: the last command failed *)
    q_xTimeout : BOOL;   (* latched: the valve did not reply in time *)
END_VAR
VAR
    fbNporValve : FB_ViciValve;   (* port selector valve *)
    iNumPorts   : INT := 12;       (* number of ports of a 12 port valve *)

    {attribute 'pytmc' := '
        pv: iReqPos
        io: io
     '}
    iReqPos : INT;
    {attribute 'pytmc' := '
        pv: SampleNames
        io: io
     '}
    stSampleNames : ST_12ViciValveSampleNames;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[fbNporValve(iAddress    := iAddress,
            iNumOfPorts := iNumPorts,
            iReqPos     := iReqPos,
            i_xExecute  := i_xExecute,
            i_xAck      := i_xAck,
            q_xDone     => q_xDone,
            q_xError    => q_xError,
            q_xTimeout  => q_xTimeout);
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>