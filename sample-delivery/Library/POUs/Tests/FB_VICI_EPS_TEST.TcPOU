<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <POU Name="FB_VICI_EPS_TEST" Id="{9e7a45ca-c992-443a-af30-6d6586b9a3e1}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_VICI_EPS_TEST EXTENDS FB_TestSuite
VAR_INPUT
END_VAR
VAR_OUTPUT
END_VAR
VAR

// TestEnableOverrideExpectOverrideToAutoRestAfterTimerExpires FBs
// These Fbs need to be defined outside of Test for Timers To Function Correcly.

    fbViciEPS : FB_VICI_EPS_LOGIC;
    aEPS : ARRAY[1..4] OF E_VICI_PORT_EPS;
    fbEPS : FB_EPS;
    bAllPortsLocked : BOOL;
    iReqNewPort : INT := 1;
    iNumPorts: INT := 4;
    bExternalSignal: BOOL;
    bOverride : BOOL := FALSE;
    fbTestTimer : TON;
    bTestInit : BOOL := TRUE;


END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[TestRequestEpsNotOkPortExpectNoPortChange();
TestActivePortBecomesLockedExpectExternalSignalSetTrue();
TestAllPortsLockedExpectbAllPortsLockedToBeTrue();
TestEpsPortStatusChangeExpectPortStatusToChange();
TestLockedPortMovesWithOverrideExpectPortToMove();
TestEnableOverrideExpectOverrideToAutoRestAfterTimerExpires();
]]></ST>
    </Implementation>
    <Method Name="TestActivePortBecomesLockedExpectExternalSignalSetTrue" Id="{410125a3-8cc0-4ee9-90f5-443f51d6ea3e}">
      <Declaration><![CDATA[METHOD TestActivePortBecomesLockedExpectExternalSignalSetTrue : REFERENCE TO FB_Test
VAR
    aEPS : ARRAY[1..4] OF E_VICI_PORT_EPS; // EPS input and port status of the four sample ports.
    fbViciEPS : FB_VICI_EPS_LOGIC; // Block under test.
    fbEPS : FB_EPS; // Helper that writes the raw EPS bits of one port.

    bExternalSignal : BOOL; // Captured bExternalLockSignal output.
    bAllPortsLocked : BOOL; // Captured bAllPortsLocked output.
    bOverride : BOOL := FALSE; // Manual override handed to the block.

    iReqPort : INT; // Port requested by the operator.
    iPrevPort : INT; // Port the valve currently sits on.
    iNewPortPos : INT; // Captured iNewPortPos output.
    iNumPorts : INT := 4; // Number of sample ports on the valve.
    iIndex : INT; // Port loop index.

    iTestStep : INT; // Phase of the cycle state machine; 0 builds the fixture.
    iCycleCount : INT; // Complete block cycles executed in the current phase.
    iHoldCycles : INT := 3; // Cycles each phase is held and asserted for.
    bTestFinished : BOOL := FALSE; // Test already reported; stop advancing the fixture.
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[(*
    TestActivePortBecomesLockedExpectExternalSignalSetTrue
    Purpose:  Verify that FB_VICI_EPS_LOGIC asserts bExternalLockSignal when the
              port the valve sits on loses its EPS, and that the manual override
              suppresses that signal again.
    Usage:    Called once per PLC cycle from the body of FB_VICI_EPS_TEST. The
              test is a step machine: every step drives the fixture, advances the
              block under test by exactly one cycle and only then asserts.
    Objectives:
              - single-cycle behaviour: each transition is already visible on the
                first cycle that sees the changed input;
              - multi-cycle behaviour: the same result is asserted on several
                consecutive cycles, so a one-cycle pulse or a state that
                collapses again is caught;
              - the override phase runs while the override countdown timer is
                still live.
    History:  2026-11-28  Rewritten as a cycle-stepped state machine; the block is
                          no longer called and asserted inside one statement block
                          (audit finding bae475bb-c393-4458-b174-18ef21c94cbd).
*)
TEST('TestActivePortBecomesLockedExpectExternalSignalSetTrue');

// Test finished and reported: leave the fixture untouched from now on.
IF bTestFinished THEN
    RETURN;
END_IF

IF iTestStep = 0 THEN
    // -------------------------------------------------------------------------
    // Fixture: ports 1..4 all report EPS OK and the valve already sits on the
    // requested port 1. No block cycle is executed in this cycle.
    // -------------------------------------------------------------------------
    iNumPorts := 4;
    iReqPort := 1;
    iPrevPort := 1;
    bOverride := FALSE;
    bExternalSignal := FALSE;
    bAllPortsLocked := FALSE;
    iNewPortPos := 0;
    iCycleCount := 0;

    FOR iIndex := 1 TO iNumPorts BY 1 DO
        fbEPS(eps := aEPS[iIndex].stEPS);
        fbEPS.setBit(nBits := 0, bValue := TRUE);
    END_FOR

    // Keep the manual override alive well past the end of this test so that
    // phase C is a genuine multi-cycle phase and not a race with the timer.
    fbViciEPS.M_SET_OVERRIDE_RESET_TIME(tNewTime := T#10s);

    iTestStep := 1;

ELSE
    // -------------------------------------------------------------------------
    // Advance FB_VICI_EPS_LOGIC by exactly one PLC cycle.
    // -------------------------------------------------------------------------
    fbViciEPS(aPortEPS := aEPS,
        iReqPort := iReqPort,
        iPrevPort := iPrevPort,
        bOverride := bOverride,
        iNumPorts := iNumPorts,
        bExternalLockSignal => bExternalSignal,
        bAllPortsLocked => bAllPortsLocked,
        iNewPortPos => iNewPortPos);

    iCycleCount := iCycleCount + 1;

    CASE iTestStep OF
    1:
        // Phase A: all ports healthy, port 1 active -> no external lock signal.
        IF iCycleCount = 1 THEN
            AssertEquals_BOOL(Expected:= FALSE, Actual:= bExternalSignal,
                Message:= 'Phase A: bExternalSignal not FALSE after one cycle with the active port unlocked');
        ELSE
            AssertEquals_BOOL(Expected:= FALSE, Actual:= bExternalSignal,
                Message:= 'Phase A: bExternalSignal changed while the active port stayed unlocked');
        END_IF

        AssertEquals_BOOL(Expected:= TRUE,
            Actual:= (aEPS[1].ePortStatus = E_VICI_EPS_PORT_STATUS.ACTIVE),
            Message:= 'Phase A: PORT 1 is NOT ACTIVE');

        AssertEquals_BOOL(Expected:= FALSE, Actual:= bAllPortsLocked,
            Message:= 'Phase A: bAllPortsLocked should be FALSE with no port locked');

        IF iCycleCount >= iHoldCycles THEN
            // Phase B input change: port 1 loses its EPS. The block only sees it
            // in the following cycle, so the assertions above describe a phase
            // the block really ran, not a same-cycle snapshot.
            fbEPS(eps := aEPS[1].stEPS);
            fbEPS.setBit(nBits := 0, bValue := FALSE);
            iTestStep := 2;
            iCycleCount := 0;
        END_IF

    2:
        // Phase B: the port the valve sits on is locked.
        IF iCycleCount = 1 THEN
            AssertEquals_BOOL(Expected:= TRUE, Actual:= bExternalSignal,
                Message:= 'Phase B: bExternalSignal not TRUE after one cycle with the active port locked');
        ELSE
            AssertEquals_BOOL(Expected:= TRUE, Actual:= bExternalSignal,
                Message:= 'Phase B: bExternalSignal dropped while the active port stayed locked');
        END_IF

        AssertEquals_BOOL(Expected:= TRUE,
            Actual:= (aEPS[1].ePortStatus = E_VICI_EPS_PORT_STATUS.LOCKED),
            Message:= 'Phase B: PORT 1 is NOT IN LOCKED STATE');

        AssertEquals_INT(Expected:= 1, Actual:= iNewPortPos,
            Message:= 'Phase B: VICI EPS MOVED TO A LOCKED PORT');

        IF iCycleCount >= iHoldCycles THEN
            // Phase C input change: enable the manual override for the locked
            // port; the block sees it in the following cycle.
            bOverride := TRUE;
            iTestStep := 3;
            iCycleCount := 0;
        END_IF

    3:
        // Phase C: override enabled -> lock signal suppressed, port forced ACTIVE.
        IF iCycleCount = 1 THEN
            AssertEquals_BOOL(Expected:= FALSE, Actual:= bExternalSignal,
                Message:= 'Phase C: bExternalSignal not FALSE after one cycle with the override enabled');
        ELSE
            AssertEquals_BOOL(Expected:= FALSE, Actual:= bExternalSignal,
                Message:= 'Phase C: bExternalSignal came back while the override was still enabled');
        END_IF

        AssertEquals_BOOL(Expected:= TRUE,
            Actual:= (aEPS[1].ePortStatus = E_VICI_EPS_PORT_STATUS.ACTIVE),
            Message:= 'Phase C: OVERRIDE DID NOT FORCE PORT 1 ACTIVE');

        AssertEquals_BOOL(Expected:= TRUE, Actual:= bOverride,
            Message:= 'Phase C: bOverride was cleared inside the block before the phase completed');

        IF iCycleCount >= iHoldCycles THEN
            TEST_FINISHED();
            bTestFinished := TRUE;
        END_IF
    END_CASE
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="TestAllPortsLockedExpectbAllPortsLockedToBeTrue" Id="{d7534117-3ba8-42eb-8609-ee403d58a03b}">
      <Declaration><![CDATA[METHOD TestAllPortsLockedExpectbAllPortsLockedToBeTrue :  REFERENCE TO FB_Test
VAR_INPUT
END_VAR
VAR
    fbViciEPS : FB_VICI_EPS_LOGIC;
    aEPS : ARRAY[1..4] OF E_VICI_PORT_EPS;

    fbEPS : FB_EPS;

    bAllPortsLocked : BOOL;
    iReqNewPort : INT;
    iNumPorts: INT := 4;
    bExternalSignal: BOOL;
    bOverride : BOOL := FALSE;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('TestAllPortsLockedExpectbAllPortsLockedToBeTrue');
fbEPS(eps:=aEPS[1].stEPS);
fbEPS.setBit(0, TRUE);

fbEPS(eps:=aEPS[2].stEPS);
fbEPS.setBit(0, TRUE);

fbEPS(eps:=aEPS[3].stEPS);
fbEPS.setBit(0, TRUE);

fbEPS(eps:=aEPS[4].stEPS);
fbEPS.setBit(0, TRUE);

fbViciEPS(aPortEPS := aEPS,
    iReqPort := 1,
    iPrevPort := iReqNewPort,
    bOverride := bOverride,
    iNumPorts := iNumPorts,
    bExternalLockSignal => bExternalSignal,
    bAllPortsLocked => bAllPortsLocked,
    iNewPortPos => iReqNewPort);

AssertEquals_BOOL(
    Expected:= FALSE ,
    Actual:= bAllPortsLocked,
    Message:= 'ALL PORTS ARE LOCKED'
);

fbEPS(eps:=aEPS[1].stEPS);
fbEPS.setBit(0, FALSE);

fbEPS(eps:=aEPS[2].stEPS);
fbEPS.setBit(0, FALSE);

fbEPS(eps:=aEPS[3].stEPS);
fbEPS.setBit(0, FALSE);

fbEPS(eps:=aEPS[4].stEPS);
fbEPS.setBit(0, FALSE);

fbViciEPS(aPortEPS := aEPS,
    iReqPort := 1,
    iPrevPort := iReqNewPort,
    bOverride := bOverride,
    iNumPorts := iNumPorts,
    bExternalLockSignal => bExternalSignal,
    bAllPortsLocked => bAllPortsLocked,
    iNewPortPos => iReqNewPort);

AssertEquals_BOOL(
    Expected:= TRUE ,
    Actual:= bAllPortsLocked,
    Message:= 'ALL PORTS ARE NOT LOCKED'
);

TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="TestEnableOverrideExpectOverrideToAutoRestAfterTimerExpires" Id="{70436f93-bf6a-4c8b-9cd1-51dbe5145d78}">
      <Declaration><![CDATA[METHOD TestEnableOverrideExpectOverrideToAutoRestAfterTimerExpires : REFERENCE TO FB_TEST
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('TestEnableOverrideExpectOverrideToAutoRestAfterTimerExpires');

IF bTestInit THEN
    fbEPS(eps:=aEPS[1].stEPS);
    fbEPS.setBit(0, FALSE);

    fbEPS(eps:=aEPS[2].stEPS);
    fbEPS.setBit(0, FALSE);

    fbEPS(eps:=aEPS[3].stEPS);
    fbEPS.setBit(0, FALSE);

    fbEPS(eps:=aEPS[4].stEPS);
    fbEPS.setBit(0, TRUE);

    fbViciEPS.M_SET_OVERRIDE_RESET_TIME(tNewTime:=T#100ms);
    fbTestTimer.PT := T#500ms;
    fbTestTimer.IN := TRUE;

    // Enable Override
    bOverride := TRUE;

    // Move To Locked Port
    iReqNewPort := 1;

    fbViciEPS(aPortEPS := aEPS,
    iReqPort := iReqNewPort,
    iPrevPort := iReqNewPort,
    bOverride := bOverride,
    iNumPorts := iNumPorts,
    bExternalLockSignal => bExternalSignal,
    bAllPortsLocked => bAllPortsLocked,
    iNewPortPos => iReqNewPort);

    AssertEquals_INT(
    Expected:= E_VICI_EPS_PORT_STATUS.ACTIVE ,
    Actual:= aEPS[1].ePortStatus,
    Message:= 'PORT 1: NOT ACTIVE'
    );

    bTestInit := FALSE;

END_IF

fbViciEPS(aPortEPS := aEPS,
    iReqPort := iReqNewPort,
    iPrevPort := iReqNewPort,
    bOverride := bOverride,
    iNumPorts := iNumPorts,
    bExternalLockSignal => bExternalSignal,
    bAllPortsLocked => bAllPortsLocked,
    iNewPortPos => iReqNewPort);

IF  NOT bOverride OR fbTestTimer.Q THEN

    // Test if bOverride Reset.
    AssertEquals_BOOL(
    Expected:= FALSE ,
    Actual:= bOverride,
    Message:= 'bOverride was Not Reset');

    // TRY Blocked Move after override reset.
    iReqNewPort := 1;

    fbViciEPS(aPortEPS := aEPS,
    iReqPort := iReqNewPort,
    iPrevPort := iReqNewPort,
    bOverride := bOverride,
    iNumPorts := iNumPorts,
    bExternalLockSignal => bExternalSignal,
    bAllPortsLocked => bAllPortsLocked,
    iNewPortPos => iReqNewPort);

    AssertEquals_INT(
    Expected:= E_VICI_EPS_PORT_STATUS.LOCKED ,
    Actual:= aEPS[1].ePortStatus,
    Message:= 'PORT 1: IS ACTIVE'
    );

    TEST_FINISHED();
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="TestEpsPortStatusChangeExpectPortStatusToChange" Id="{89ca8612-4d1a-4a67-a4ac-7c1f417d6511}">
      <Declaration><![CDATA[METHOD TestEpsPortStatusChangeExpectPortStatusToChange :  REFERENCE TO FB_Test
VAR_INPUT
END_VAR
VAR
    fbViciEPS : FB_VICI_EPS_LOGIC;
    aEPS : ARRAY[1..4] OF E_VICI_PORT_EPS;

    fbEPS : FB_EPS;

    bAllPortsLocked : BOOL;
    iReqNewPort : INT := 1;
    iNumPorts: INT := 4;
    bExternalSignal: BOOL;
    bOverride : BOOL := FALSE;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('TestEpsPortStatusChangeExpectPortStatusToChange');
fbEPS(eps:=aEPS[1].stEPS);
fbEPS.setBit(0, TRUE);

fbEPS(eps:=aEPS[2].stEPS);
fbEPS.setBit(0, TRUE);

fbEPS(eps:=aEPS[3].stEPS);
fbEPS.setBit(0, TRUE);

fbEPS(eps:=aEPS[4].stEPS);
fbEPS.setBit(0, TRUE);

// MAKE PORT 1 ACTIVE
fbViciEPS(aPortEPS := aEPS,
    iReqPort := 1,
    iPrevPort := iReqNewPort,
    bOverride := bOverride,
    iNumPorts := iNumPorts,
    bExternalLockSignal => bExternalSignal,
    bAllPortsLocked => bAllPortsLocked,
    iNewPortPos => iReqNewPort);

AssertEquals_INT(
    Expected:= E_VICI_EPS_PORT_STATUS.ACTIVE ,
    Actual:= aEPS[1].ePortStatus,
    Message:= 'PORT 1: NOT ACTIVE'
);

// MAKE PORT 1 UNLOCKED

fbViciEPS(aPortEPS := aEPS,
    iReqPort := 2,
    iPrevPort := iReqNewPort,
    bOverride := bOverride,
    iNumPorts := iNumPorts,
    bExternalLockSignal => bExternalSignal,
    bAllPortsLocked => bAllPortsLocked,
    iNewPortPos => iReqNewPort);

AssertEquals_INT(
    Expected:= E_VICI_EPS_PORT_STATUS.UNLOCKED ,
    Actual:= aEPS[1].ePortStatus,
    Message:= 'PORT 1: NOT IN UNLOCKED STATE'
);

// MAKE PORT 1 LOCKED
fbEPS(eps:=aEPS[1].stEPS);
fbEPS.setBit(0, FALSE);

fbViciEPS(aPortEPS := aEPS,
    iReqPort := 2,
    iPrevPort := iReqNewPort,
    bOverride := bOverride,
    iNumPorts := iNumPorts,
    bExternalLockSignal => bExternalSignal,
    bAllPortsLocked => bAllPortsLocked,
    iNewPortPos => iReqNewPort);

AssertEquals_INT(
    Expected:= E_VICI_EPS_PORT_STATUS.LOCKED ,
    Actual:= aEPS[1].ePortStatus,
    Message:= 'PORT 1: NOT IN LOCKED STATE'
);

TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="TestLockedPortMovesWithOverrideExpectPortToMove" Id="{6a29d7d9-78d4-48e7-80e2-1bedbd3bcb74}">
      <Declaration><![CDATA[METHOD TestLockedPortMovesWithOverrideExpectPortToMove :  REFERENCE TO FB_Test
VAR_INPUT
END_VAR
VAR
    fbViciEPS : FB_VICI_EPS_LOGIC;
    aEPS : ARRAY[1..4] OF E_VICI_PORT_EPS;

    fbEPS : FB_EPS;
    bAllPortsLocked : BOOL;
    iReqNewPort : INT;
    iNumPorts : INT := 4;
    bExternalSignal: BOOL;
    bOverride : BOOL := FALSE;

    fbTestTimer : TON;
    iCount : INT := 0;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('TestLockedPortMovesWithOverrideExpectPortToMove');
fbEPS(eps:=aEPS[1].stEPS);
fbEPS.setBit(0, TRUE);

fbEPS(eps:=aEPS[2].stEPS);
fbEPS.setBit(0, TRUE);

fbEPS(eps:=aEPS[3].stEPS);
fbEPS.setBit(0, FALSE);

fbEPS(eps:=aEPS[4].stEPS);
fbEPS.setBit(0, TRUE);

// REQUEST PORT 1
fbViciEPS(aPortEPS := aEPS,
    iReqPort := 1,
    iPrevPort := iReqNewPort,
    bOverride := bOverride,
    iNumPorts := iNumPorts,
    bExternalLockSignal => bExternalSignal,
    bAllPortsLocked => bAllPortsLocked,
    iNewPortPos => iReqNewPort);

AssertEquals_INT(Expected:= 1 ,
    Actual:= iReqNewPort,
    Message:= 'VICI EPS DID NOT MOVE TO ALLOWED PORT');

// REQUEST PORT 3 w/ Override

bOverride := TRUE;

fbViciEPS(aPortEPS := aEPS,
    iReqPort := 3,
    iPrevPort := iReqNewPort,
    bOverride := bOverride,
    iNumPorts := iNumPorts,
    bExternalLockSignal => bExternalSignal,
    bAllPortsLocked => bAllPortsLocked,
    iNewPortPos => iReqNewPort);

AssertEquals_INT(Expected:= 3 ,
    Actual:= iReqNewPort,
    Message:= 'VICI EPS OVERRIDE FAILED');

TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="TestRequestEpsNotOkPortExpectNoPortChange" Id="{2deb68af-d1f2-4ae5-8783-ea2517fe3682}">
      <Declaration><![CDATA[METHOD TestRequestEpsNotOkPortExpectNoPortChange :  REFERENCE TO FB_Test
VAR_INPUT
END_VAR
VAR
    fbViciEPS : FB_VICI_EPS_LOGIC;
    aEPS : ARRAY[1..4] OF E_VICI_PORT_EPS;
    fbEPS : FB_EPS;
    bAllPortsLocked : BOOL;
    iReqNewPort : INT;
    iNumPorts : INT := 4;
    bExternalSignal : BOOL;
    bOverride : BOOL := FALSE;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('TestRequestEpsNotOkPortExpectNoPortChange');

fbEPS(eps:=aEPS[1].stEPS);
fbEPS.setBit(0, TRUE);

fbEPS(eps:=aEPS[2].stEPS);
fbEPS.setBit(0, TRUE);

fbEPS(eps:=aEPS[3].stEPS);
fbEPS.setBit(0, FALSE);

fbEPS(eps:=aEPS[4].stEPS);
fbEPS.setBit(0, TRUE);

// REQUEST PORT 1
fbViciEPS(aPortEPS := aEPS,
    iReqPort := 1,
    iPrevPort := iReqNewPort,
    bOverride := bOverride,
    iNumPorts := iNumPorts,
    bExternalLockSignal => bExternalSignal,
    bAllPortsLocked => bAllPortsLocked,
    iNewPortPos => iReqNewPort);

AssertEquals_INT(Expected:= 1 ,
    Actual:= iReqNewPort,
    Message:= 'VICI EPS DID NOT MOVE TO ALLOWED PORT');

// REQUEST PORT 3
fbViciEPS(aPortEPS := aEPS,
    iReqPort := 3,
    iPrevPort := iReqNewPort,
    bOverride := bOverride,
    iNumPorts := iNumPorts,
    bExternalLockSignal => bExternalSignal,
    bAllPortsLocked => bAllPortsLocked,
    iNewPortPos => iReqNewPort);

AssertEquals_INT(Expected:= 1 ,
    Actual:= iReqNewPort,
    Message:= 'VICI EPS MOVED TO BLOCKED PORT');


TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>