<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <GVL Name="GVL_SAMPLE" Id="{b2864d8f-27b9-49d7-a36f-f3e6d25b7296}">
    <Declaration><![CDATA[VAR_GLOBAL
    // First-scan marker: TRUE only on the first PLC cycle, cleared at the end of
    // EXAMPLE_DEPLOYMENT so one-shot initialization (e.g. the initial valve res
    // lock set in FB_SelectorSync) runs exactly once after startup.
    g_xFirstPass: BOOL := TRUE;
END_VAR]]></Declaration>
  </GVL>
</TcPlcObject>