<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <DUT Name="ST_RCC_ILK" Id="{3f1a5d70-0b2c-4d51-9a64-7c11e2b90a06}">
    <Declaration><![CDATA[(*
    ST_RCC_ILK - external interlock permits for the RCC (rapid cycle
    chromatography) valve state machine.

    PURPOSE
        Carries the machine-level permit plus the per-valve open permits that
        F_RCC_ILK derives from the ChemRIX valve states and the CRIX-RCC-GCP-01
        pressure gauge. FB_RCC_SM is a reusable device block and must not
        evaluate site conditions itself, so it consumes this structure through
        its i_stILK input instead.

    USAGE
        Produced by F_RCC_ILK and handed to FB_RCC_SM.i_stILK. Never populated
        by hand at a deployment.

    OBJECTIVES
        - Keep every RCC interlock condition in one single-purpose function.
        - Give each valve an individually named permit so a lost permit is
          visible on the EPICS display (ST_RCC.RCC_VRC_xx_OPEN_OK).
        - Default every member to FALSE so an unwired permit is fail-safe.

    HISTORY
        2026-11-27 / Scirix Agent
            Type created while externalising the FB_RCC_SM interlocks
            (audit finding #918, convention conv_0121ae615346).
*)
TYPE ST_RCC_ILK :
STRUCT
    xILK_OK : BOOL; // Machine-level permit: the GCP-01 pressure readback is valid
    xVRC01_OPEN_OK : BOOL; // CRIX-RCC-VRC-01 may be commanded open
    xVRC02_OPEN_OK : BOOL; // CRIX-RCC-VRC-02 may be commanded open
    xVRC03_OPEN_OK : BOOL; // CRIX-RCC-VRC-03 may be commanded open
    xVRC04_OPEN_OK : BOOL; // CRIX-RCC-VRC-04 may be commanded open
END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>
