<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <DUT Name="ST_RCC" Id="{1b353780-7d91-4e7e-9358-dff7c26eabba}">
    <Declaration><![CDATA[TYPE ST_RCC :
STRUCT
    {attribute 'pytmc' :='
        pv: Tinterval
        io: io
        autosave_pass0: VAL DESC
    '} // Time before cycle starts
    TInterval : REAL := 10;
    {attribute 'pytmc' :='
        pv: T1
        io: io
        autosave_pass0: VAL DESC
    '}
    T1 : REAL := 20;
    {attribute 'pytmc' :='
        pv: T2
        io: io
        autosave_pass0: VAL DESC
    '}
    T2 : REAL := 10;
    {attribute 'pytmc' :='
        pv: T3
        io: io
        autosave_pass0: VAL DESC
    '}
    T3 : REAL := 5;
    {attribute 'pytmc' :='
        pv: T4
        io: io
        autosave_pass0: VAL DESC
    '}
    T4 : REAL := 10;
    {attribute 'pytmc' := '
        pv: RUNCLEAN
        io: io
        field: ZNAM "NoClean"
        field: ONAM "Clean"
        field: DESC Run cleaning cycle mode
     '}
    bRunClean : BOOL := TRUE;

    {attribute 'pytmc' := '
        pv: CLEAR_ERROR
        io: io
        field: DESC Clear latched RCC error
     '}
    bClearError : BOOL := FALSE;
    {attribute 'pytmc' := '
        pv: ERROR
        io: i
        field: ZNAM "OK"
        field: ONAM "ERROR"
        field: DESC RCC error state
     '}
    bError : BOOL := FALSE;
    {attribute 'pytmc' := '
        pv: STOP_CYCLE
        io: io
        field: DESC Stop the RCC cycle
     '}
    bStop : BOOL := FALSE;

    {attribute 'pytmc' := '
        pv: START_CYCLE
        io: io
        field: DESC Start the RCC cycle
     '}
    bStartCycle : BOOL  := FALSE;

    {attribute 'pytmc' := '
        pv: ILK_Setpoint
        io: io
        autosave_pass0: VAL DESC
        field: DESC GCP-01 interlock pressure setpoint
     '}
    RCC_GCP_01_INTERLOCK_SETPOINT : REAL := 10;
    {attribute 'pytmc' := '
        pv: OverrideMode
        io: io
        field: ZNAM "Normal"
        field: ONAM "Override"
        field: DESC Manual override mode
     '}
    xSystemOverrideMode_RCC : BOOL := FALSE;

    eCurrentState : INT := E_RCC_STATES.IDLE;

    {attribute 'pytmc' :='
        pv: RCC_RUNNING
        io: o
    '}
    bRunning : BOOL := FALSE;
    {attribute 'pytmc' :='
        pv: RCC_TIMER
        io: o
    '}
    tTimerReadBack : STRING := '';
    {attribute 'pytmc' := '
        pv: sLogMessage
        io: i
        field: DESC RCC state machine log message
     '}
    sLogMessage : T_MaxString := '';

    RCC_VRC_01_OPEN_OK : BOOL;
    RCC_VRC_02_OPEN_OK : BOOL;
    RCC_VRC_03_OPEN_OK : BOOL;
    RCC_VRC_04_OPEN_OK : BOOL;

END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>