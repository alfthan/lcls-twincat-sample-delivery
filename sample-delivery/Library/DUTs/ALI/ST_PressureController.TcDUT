<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4020.12">
  <DUT Name="ST_PressureController" Id="{9d96757f-fb04-4cdc-9a8a-fde30a416828}">
    <Declaration><![CDATA[TYPE ST_PressureController :
STRUCT
    (* Intent of this structure is to provide generic variables
    for a pressure controller. It is meant to be extended by
    the hardware IO variables into a specific structure.
    All pressure values are in Torr, matching the gauge readback
    they are compared against; never write bar(g), psi or Pa into them. *)

    //Controls
    //Pressure setpoint [Torr]
    i_rPressSP	:	REAL;
    //Pressure readback from the pressure gauge [Torr]
    i_rPressRB	:	REAL;
    //Controller deadband around the setpoint [Torr]
    rDeadband	:	REAL;
    //Actuator percentage open setpoint [%], 0-100
    i_iPercOpenSP	:	INT;
    //Actuator percentage open readback [%], 0-100
    q_iPercOpen	:	INT;
    //Controller Mode
    i_eCntlMode	:	E_CTRL_MODE;
    //PID Parameters
    stPIDParams :	ST_PIDParams := (
        fKp := 1,
        fTn := 1,
        fUpperLim := 1,
        fLowerLim := -1,
        fCtrlCycleTime := 0.01
    );

END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>