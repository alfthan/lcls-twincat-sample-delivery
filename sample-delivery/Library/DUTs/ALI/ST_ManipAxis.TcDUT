<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4020.12">
  <DUT Name="ST_ManipAxis" Id="{8a2b69b2-0749-42c2-bd32-ad09794455d6}">
    <Declaration><![CDATA[TYPE ST_ManipAxis :
STRUCT

(* Controls *)
xEnable	:	BOOL := TRUE;
rReqAbsPos	:	REAL;
rReqRelPos	:	REAL;
xStart	:	BOOL;
xStop	:	BOOL;
wMode	:	E_AxisMoveMode;
//EPICS motor status
{attribute 'pytmc' := '
    pv: MSTA
    io: i
    field: DESC EPICS pseudo motor status word (bit0 enabled, bit1 error)
'}
uiMsta	:	UINT;
//EPICS Position readback
{attribute 'pytmc' := '
    pv: ActPos
    io: i
    field: EGU mm
    field: DESC Position readback
'}
rActPos	:	REAL;
//Axis enabled readback
xEnabled	:	BOOL;
//EPICS High Limit Switch (NO)
{attribute 'pytmc' := '
    pv: HLS
    io: i
    field: ZNAM FALSE
    field: ONAM TRUE
    field: DESC High limit switch (normally open field input, inverted for display)
'}
xHLS	:	BOOL;
//EPICS Low Limit Switch (NO)
{attribute 'pytmc' := '
    pv: LLS
    io: i
    field: ZNAM FALSE
    field: ONAM TRUE
    field: DESC Low limit switch (normally open field input, inverted for display)
'}
xLLS	:	BOOL;
//EPICS MOVN
{attribute 'pytmc' := '
    pv: MOVN
    io: i
    field: ZNAM Not moving
    field: ONAM Moving
    field: DESC Motion in progress
'}
xMovn	:	BOOL;
//EPICS DMOV
{attribute 'pytmc' := '
    pv: DMOV
    io: i
    field: ZNAM Moving
    field: ONAM Done
    field: DESC Motion complete
'}
xDmov	:	BOOL;
//EPICS Reset
{attribute 'pytmc' := '
    pv: Reset
    io: io
    field: ZNAM FALSE
    field: ONAM TRUE
    field: DESC Reset axis faults
'}
xReset	:	BOOL;

(* Axis motor *)
stAxis	:	AXIS_REF;
lrVelocity	:	LREAL	:=1; //mm/s

eState	:	E_AxisMotionState;

xHiLS	AT %I* :	BOOL;
xLoLS	AT %I* :	BOOL;

END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>