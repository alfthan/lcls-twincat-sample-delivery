<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4020.12">
  <DUT Name="ST_ALI" Id="{0b7a7a1a-1335-4a3d-a5dc-8467cfe96304}">
    <Declaration><![CDATA[TYPE ST_ALI EXTENDS ST_ALIIO:
STRUCT
    (* Aerodynamic Lens Injector *)

    (* Manipulator *)
    axisX	:	ST_ManipAxis; // X translation axis of the manipulator; position in mm (+/-100 mm travel), speed in mm/s
    axisY	:	ST_ManipAxis; // Y translation axis of the manipulator; position in mm (+/-100 mm travel), speed in mm/s
    axisZ	:	ST_ManipAxis; // Z translation axis of the manipulator; position in mm (+/-100 mm travel), speed in mm/s

    (* Vacuum gauges *)
    stNozzleBoxVG	: ST_VG; // Nozzle-box gauge: MKS 925 via FB_9XX (log scale); pressure in Torr
    stSkimmerVG	: ST_VG; // Skimmer gauge: MKS 925 via FB_9XX (log scale); pressure in Torr; source of the valve pressure readback
    stRelaxVG	: ST_VG := (rFULL_SCALE:=10); // Relaxation-chamber gauge: MKS 722 Baratron via FB_GCM (linear); full scale 10 Torr, pressure in Torr

    (* Butterfly valve pressure controller *)
    stPropVlv	:	ST_PropValveMKS253; // MKS 253 butterfly throttle valve + stepper: opening 0-100 %, speed in deg/s, pressure in Torr

    (* Unused: FB_ALI drives the valve through stPropVlv instead *)
    //stPressCtrl	:	ST_PressureController;


END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>