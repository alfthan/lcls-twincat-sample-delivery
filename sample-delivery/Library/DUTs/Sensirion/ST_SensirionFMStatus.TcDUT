<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4022.18">
  <DUT Name="ST_SensirionFMStatus" Id="{167d0110-ce48-475a-b7ba-7b29f3e90a1e}">
    <Declaration><![CDATA[TYPE ST_SensirionFMStatus :
STRUCT

    iFlowTicks	:	INT;	// Signed raw flow tick count of the last measurement, value range INT (-32768..32767), negative = reverse flow;
        // divide by the sensor scale factor to get nL/min (rFlow applies this and converts to uL/min)
    uiSensorOutput	: UINT;	// Raw 16 bit measurement word as received from the sensor, value range UINT (0..65535);
        // bit 15 set = negative flow, the two's complement of which iFlowTicks carries (unitless raw sensor counts)
    iState	:	INT;	// Flow range state of the last measurement: 0 = OK, 1 = over range, 2 = under range, 3 = flow invalid (driver error, no valid reading);
        // value range 0..3, mirrors E_SensirionFMMode (unitless)
    rFlow	:	REAL; // units of uL/min
    xOoR	:	BOOL; // Out of range
    xFMMode :	BOOL; // calib mode readback 0 = prec, 1 = extended
    xFlowValid	:	BOOL; // driver completes successfully
    abReply	:	ARRAY[1..500] OF BYTE;	// Raw SHDLC reply payload of the last transaction (payload only, frame delimiters, address, command, length and checksum stripped);
        // up to 500 data bytes, only the number of bytes reported by the transaction reply length are meaningful.
        // Not currently populated by FB_SensirionDriver - reserved for diagnostics.
    bStatus	:	BYTE; //Sensor status
(* Bit 0: 0: Sensor idle
        1: Sensor Busy
Bit 1: 	0: Continuous Measurement disabled
        1: Continuous Measurement enabled
Bit 2: (for Firmware . 1.3)
        0: Auto detection Measurement disabled
        1: Auto detection Measurement enabled
Bit 3: (for Firmware . 1.3)
        0: No Auto Measurement since last read out Status
        1: Auto Measurement finished since last read out Status, is set back to 0 after read out *)

END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>
