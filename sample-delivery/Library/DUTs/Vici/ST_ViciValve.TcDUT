<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <DUT Name="ST_ViciValve" Id="{e1c3e557-9352-4b67-9f4e-5df5ff478143}">
    <Declaration><![CDATA[// Interface structure for a VICI multi port selector valve (FB_ViciValve).
// It carries the complete command and status data of the valve so that the
// owning function block can expose a single VAR_IN_OUT interface.
TYPE ST_ViciValve :
STRUCT
    (* Command *)
    iAddress		: INT;			// Serial address of the VICI valve controller
    iNumOfPorts		: INT := 12;		// Number of selectable ports fitted to the valve
    iReqPos		: INT;			// Requested port position (1..iNumOfPorts)

    (* Status *)
    stStatus		: ST_ViciStatus;	// Actual position, position validity and serial replies
    xDone		: BOOL;			// Last transaction with the valve completed
    xError		: BOOL;			// Last transaction with the valve failed
    xTimeout		: BOOL;			// The valve did not reply within the driver timeout
END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>
